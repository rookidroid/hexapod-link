{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!out", "!dist", "!node_modules", "!tests/fixtures", "!src/renderer/src/styles/vendor"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "suspicious": { "noExplicitAny": "off" },
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "noLabelWithoutControl": "off", "useSemanticElements": "off", "noNoninteractiveTabindex": "off", "useFocusableInteractive": "off" },
      "complexity": { "noForEach": "off" }
    }
  },
  "css": { "linter": { "enabled": false }, "formatter": { "enabled": false } }
}
